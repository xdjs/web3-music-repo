{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{data/artist-playback-overrides.json,data/artist-presentation.json,data/audio-analysis.json,data/catalog/archived-media.json,data/catalog/ethereum-revenue-audit.json,data/catalog/holder-history.json,data/catalog/live-verification.json,data/catalog/song-revenue.json,data/catalog/token-inventory.json,data/census/1-1.json,data/census/1-10.json,data/census/2-1.json,data/census/2-10.json,data/census/2-137-rpc.json,data/census/2-8453-rpc.json,data/census/manifest.json,data/expanded-playback-audit.json,data/historical-artists.json,data/historical-playlists.json,data/historical-profiles.json,data/legacy-expanded.json,data/mint-songs/archived-media.json,data/music-metadata.json,data/pete-recovery/recovered-media.json,data/pete-recovery/zora-recovered-media.json,data/playback-audit.json,data/playlist-activity-recovery.json,data/playlist-track-recovery.json,data/privy-public-config.json,data/recovery-snapshot.json,data/release-dates.json,data/sound-expanded.json,data/sound-fallback.json,data/sound-metadata-gaps.json,data/sound-resolution/archived-recovery.json,data/sound-resolution/catalog-reconciliation.json,data/sound-v1-1-index.json,data/sound-v1-10-index.json,data/sound-v2-10-index.json,data/sound-v2-index.json,data/spinamp/collector-snapshots.json,data/spinamp/indexed-releases.json,data/spinamp/playback-copies.json,data/spinamp/recovered-media.json,data/static-assets.json,data/supercollector/recovered-media.json,data/verified-credits.json,data/zora-expanded.json,data/zora-onchain-comments.json,evidence/sound-wayback/playlist-data.json,evidence/sound-wayback/recovered-comments.json}",
      "excludeFiles": "{public/**,dist/**,work/**,private/**,captures/**,docs/**,tests/**,.env*,evidence/reference-screens/**,evidence/catalog-payments/**}"
    }
  },
  "rewrites": [
    {
      "source": "/share/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/catalog",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "index"
        }
      ],
      "destination": "/catalog/index.json"
    },
    {
      "source": "/api/catalog",
      "destination": "/catalog/full.json"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
