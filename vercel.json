{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{data/*.json,data/{census,mint-songs,pete-recovery,sound-resolution,spinamp,supercollector}/*.json,data/catalog/{*media,live*,*revenue*,holder-history,token-inventory}.json,evidence/sound-wayback/{playlist-data,recovered-comments}.json}",
      "excludeFiles": "{public/**,dist/**,work/**,private/**,captures/**,docs/**,tests/**,.env*,evidence/reference-screens/**,evidence/catalog-payments/**,data/{metadata-enrichment-checkpoint,lyrics-recovery}.json}"
    }
  },
  "rewrites": [
    {
      "source": "/share/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/catalog",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "index"
        }
      ],
      "destination": "/catalog/index.json"
    },
    {
      "source": "/api/catalog",
      "destination": "/catalog/full.json"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
